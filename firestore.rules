rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{document=**} {
      allow read, write: if true;
    }
    match /content_plans/{document=**} {
      allow read, write: if true;
    }
    match /brand_settings/{document=**} {
      allow read, write: if true;
    }
    match /users/{document=**} {
      allow read, write: if true;
    }
  }
}
